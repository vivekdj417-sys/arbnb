<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OkBack Airbnb</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">OkBack Airbnb</a>
        <nav>
          <a href="/">Home</a>
          <a href="/create-listing">Host</a>
          <a href="/bookings">Bookings</a>
          <% if (currentUser) { %>
          <span class="nav-user">Hi, <%= currentUser.name %></span>
          <a href="/logout" class="button-link">Logout</a>
          <% } else { %>
          <a href="/login">Login</a>
          <a href="/register" class="button-link">Sign up</a>
          <% } %>
        </nav>
      </div>
    </header>
    <main class="container">
