<%- include("partials/header") %>
<section class="hero">
  <div>
    <h1>Discover stays for every trip</h1>
    <p>Browse cozy homes, apartments, and unique spaces from hosts around the world.</p>
  </div>
</section>

<section class="grid">
  <% if (listings.length === 0) { %>
  <p>No listings available yet. Login and create a new host listing.</p>
  <% } %>
  <% listings.forEach((listing) => { %>
  <article class="card">
    <img src="<%= listing.images[0] || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85' %>" alt="<%= listing.title %>" />
    <div class="card-body">
      <h2><%= listing.title %></h2>
      <p><%= listing.description %></p>
      <p><strong>City:</strong> <%= listing.city %></p>
      <p><strong>Price:</strong> $<%= listing.pricePerNight %> / night</p>
      <a class="button-link" href="/listing/<%= listing.id %>">View listing</a>
    </div>
  </article>
  <% }) %>
</section>

<%- include("partials/footer") %>
